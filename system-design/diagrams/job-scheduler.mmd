    W2["Worker"]
    W3["Worker"]
  end
  subgraph Out["Results"]
    direction LR
    RES[("Run history")]
    DLQ["DLQ / alerts"]
  end
  Front -->|"due jobs"| Sched
  Sched --> Q
  Q --> Pool
  Pool --> Out
